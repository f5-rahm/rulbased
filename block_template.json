{
  "name": "rulbased",
  "description": "Rülbased — Version control for BIG-IP iRules: snapshot, diff, deploy and rollback",
  "inputProperties": [
    {
      "id": "pollIntervalSeconds",
      "type": "NUMBER",
      "displayName": "Poll interval (seconds)",
      "description": "How often to check for external iRule changes. Set to 0 to disable polling.",
      "defaultValue": 300,
      "isRequired": false
    },
    {
      "id": "dataDirectory",
      "type": "STRING",
      "displayName": "Data directory path",
      "description": "Filesystem path where version store data is written.",
      "defaultValue": "/var/config/rest/iapps/rulbased/data",
      "isRequired": false
    },
    {
      "id": "syslogEnabled",
      "type": "BOOLEAN",
      "displayName": "Enable syslog notifications",
      "description": "Emit syslog entries on deploy and rollback events.",
      "defaultValue": true,
      "isRequired": false
    },
    {
      "id": "webhookUrl",
      "type": "STRING",
      "displayName": "Webhook URL",
      "description": "HTTP POST endpoint for deploy/rollback notifications (Slack, Teams, etc). Leave empty to disable.",
      "defaultValue": "",
      "isRequired": false
    }
  ],
  "outputProperties": [
    {
      "id": "trackedRuleCount",
      "type": "NUMBER",
      "displayName": "Tracked iRule count"
    },
    {
      "id": "driftedRuleCount",
      "type": "NUMBER",
      "displayName": "Rules with unversioned drift"
    },
    {
      "id": "lastPollTimestamp",
      "type": "STRING",
      "displayName": "Last poll timestamp (ISO 8601)"
    },
    {
      "id": "installedVersion",
      "type": "STRING",
      "displayName": "Extension version"
    }
  ],
  "configProcessorReference": {
    "link": "https://localhost/mgmt/shared/iapp/processors/rulbased"
  },
  "presentationHtmlReference": {
    "link": "https://localhost/iapps/rulbased/presentation/index.html"
  }
}
